local RunService = game:GetService("RunService")
local Async      = {}
Async.__index    = Async

function Async:Batch(tasks, batchSize)
	task.spawn(function()
		local i, n = 1, #tasks
		while i <= n do
			for _ = 1, batchSize do
				if i > n then break end
				tasks[i]()
				i += 1
			end
			RunService.Heartbeat:Wait()
		end
	end)
end

return Async
